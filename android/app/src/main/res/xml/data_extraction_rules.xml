<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep finance data and session cookies out of cloud backups and device-to-device
     transfers. Everything lives on the server anyway; a fresh install just signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
