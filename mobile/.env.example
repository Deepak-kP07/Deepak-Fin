# The deployed web app — the native app calls its /api routes. Use the www. host: the bare domain
# redirects, and a redirect drops the Authorization header.
EXPO_PUBLIC_API_URL=https://www.personalfin.site
# Same Supabase project as the web app (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
# The anon key is public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
