# Direct Postgres connection string, used by Drizzle for migrations
DATABASE_URL="postgresql://user:password@host:port/postgres"

# This app's own deployed origin
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase project — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zerodha Kite Connect — optional, live investment pricing falls back to Yahoo Finance without it
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Vault module — AES-256-GCM key for encrypting bank/card details at rest. Required for the
# Vault module to work at all. Generate with: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=

# Push notifications — Web Push (VAPID), no Firebase/external service needed. Generate a keypair
# with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push service can reach if it flags your server — a mailto: address or your app's URL
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the notification cron route checks for (it fires with no logged-in user) —
# generate with: openssl rand -hex 32
CRON_SECRET=
