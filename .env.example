# Direct Postgres connection string, used by Drizzle for migrations
DATABASE_URL="postgresql://user:password@host:port/postgres"

# This app's own deployed origin
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase project — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Identity Services (client-side Google sign-in) — the Web OAuth Client ID already
# configured in Supabase Dashboard > Authentication > Providers > Google. Also add this app's
# origin(s) (e.g. http://localhost:3000, your prod domain) to that Client ID's "Authorized
# JavaScript origins" in Google Cloud Console > Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Zerodha Kite Connect — this is the app owner's own Kite Connect app (developers.kite.trade),
# used as the default for every user who hasn't set up their own. Anyone can instead save their
# own API key/secret from Settings > Kite Connect inside the app, which then always takes
# precedence over this default for them from that point on. Live investment pricing falls back
# to Yahoo Finance if neither is set.
KITE_API_KEY=
KITE_API_SECRET=

# Vault module — AES-256-GCM key for encrypting bank/card details at rest. Required for the
# Vault module to work at all. Generate with: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=

# Push notifications — Web Push (VAPID), no Firebase/external service needed. Generate a keypair
# with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push service can reach if it flags your server — a mailto: address or your app's URL
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the notification cron route checks for (it fires with no logged-in user) —
# generate with: openssl rand -hex 32
CRON_SECRET=

# Resend — sends money-profile-sharing invite emails. Get an API key from resend.com.
# RESEND_FROM_EMAIL must be an address on a domain you've verified with Resend, or use their
# sandbox address (onboarding@resend.dev) until you've verified your own domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
